usage() {
  cat <<EOD
Usage: $0 [OPTION]... [--] COMMAND ARGUMENTS

Options:
  --help                     Displays this message.
  --gpu GPU_ID               GPU to target.
  --device-id DEVICE_ID      PCI ID to target.
  --device-json PATH         Path to JSON generated by intel_dev_tool on the target device.
  --cache CACHE_DIR          Mesa shader cache directory.
EOD
}

base="$(dirname "$0")/${base}"
basedir="${base%/*}"

gpu=""
device_id=""
device_json=""

while true; do
  case "$1" in
    --gpu)
      gpu="$2"
      shift 2
      ;;
    --device-id)
      device_id="$2"
      shift 2
      ;;
    --device-json)
      device_json="$2"
      shift 2
      ;;
    --cache)
      cache="$2"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    -*)
      echo "$0: invalid option: $1"
      usage
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

if [ -n "${device_json}" ]; then
  export INTEL_STUB_GPU_JSON="${device_json}"
  if [ -n "${gpu}" ] || [ -n "{$device_id}" ]; then
    echo "WARNING: --gpu and --device-id flags ignored because --device-json is set"
  fi
elif [ -n "${device_id}" ]; then
  export INTEL_STUB_GPU_DEVICE_ID="${device_id}"
  if [ -n "${gpu}" ]; then
    echo "WARNING: --gpu flag is ignored because --device-id is set"
  fi
else
  export INTEL_STUB_GPU_PLATFORM="${gpu}"
fi
export LDDTREE_PRELOAD="${basedir}/lib/libintel_noop_drm_shim.so"
export VK_ICD_FILENAMES="${basedir}/share/vulkan/icd.d/intel_icd.x86_64.json"
export MESA_SHADER_CACHE_DISABLE=false
export MESA_DISK_CACHE_SINGLE_FILE=1
if [ -n "${cache}" ]; then
  export MESA_SHADER_CACHE_DIR="${cache}"
fi
PATH="${basedir}/bin:${PATH}"

exec "$@"
